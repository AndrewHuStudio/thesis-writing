<!-- Arrow Up Regular and Stop Filled from Microsoft Fluent UI System Icons (MIT). -->
<ControlTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" TargetType="Button">
  <Grid x:Name="Icon" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Ellipse x:Name="Disc" Fill="{TemplateBinding Background}"/>
    <Path x:Name="SendIcon" Data="M4.20889 10.7327C3.9232 11.0326 3.93475 11.5074 4.23467 11.7931C4.5346 12.0788 5.00933 12.0672 5.29502 11.7673L11.2495 5.516V20.25C11.2495 20.6642 11.5853 21 11.9995 21C12.4137 21 12.7495 20.6642 12.7495 20.25V5.51565L18.7043 11.7673C18.99 12.0672 19.4648 12.0788 19.7647 11.7931C20.0646 11.5074 20.0762 11.0326 19.7905 10.7327L12.7238 3.31379C12.5627 3.14474 12.3573 3.04477 12.1438 3.01386C12.0971 3.00477 12.0489 3 11.9995 3C11.9498 3 11.9012 3.00483 11.8543 3.01406C11.6412 3.04518 11.4363 3.14509 11.2756 3.31379L4.20889 10.7327Z" Fill="#286642" Stretch="Uniform"
          Width="15" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <Path x:Name="StopIcon" Data="M4.75 3C3.7835 3 3 3.7835 3 4.75V19.25C3 20.2165 3.7835 21 4.75 21H19.25C20.2165 21 21 20.2165 21 19.25V4.75C21 3.7835 20.2165 3 19.25 3H4.75Z" Fill="White" Stretch="Uniform" Visibility="Collapsed"
          Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
  </Grid>
  <ControlTemplate.Triggers>
    <Trigger Property="Tag" Value="Stop">
      <Setter TargetName="Disc" Property="Fill" Value="#282C2A"/>
      <Setter TargetName="SendIcon" Property="Visibility" Value="Collapsed"/>
      <Setter TargetName="StopIcon" Property="Visibility" Value="Visible"/>
    </Trigger>
    <Trigger Property="IsMouseOver" Value="True">
      <Setter TargetName="Disc" Property="Stroke" Value="#78A68A"/>
    </Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True">
      <Setter TargetName="Disc" Property="Stroke" Value="#599A78"/>
      <Setter TargetName="Disc" Property="StrokeThickness" Value="2"/>
    </Trigger>
    <Trigger Property="IsPressed" Value="True">
      <Setter TargetName="Icon" Property="Opacity" Value="0.8"/>
    </Trigger>
    <Trigger Property="IsEnabled" Value="False">
      <Setter TargetName="SendIcon" Property="Fill" Value="#939B96"/>
      <Setter TargetName="StopIcon" Property="Fill" Value="#939B96"/>
    </Trigger>
    <MultiTrigger>
      <MultiTrigger.Conditions>
        <Condition Property="Tag" Value="Stop"/>
        <Condition Property="IsEnabled" Value="False"/>
      </MultiTrigger.Conditions>
      <Setter TargetName="Disc" Property="Fill" Value="#EDF0EE"/>
    </MultiTrigger>
  </ControlTemplate.Triggers>
</ControlTemplate>
